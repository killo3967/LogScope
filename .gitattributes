# Normaliza finales de línea en el índice y en el checkout
* text=auto eol=lf

# Los scripts de CMD necesitan CRLF aunque el resto del arbol vaya en LF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios
*.png binary
*.ico binary
*.icns binary
*.jpg binary

# Ficheros de lock: sin ruido en diffs
package-lock.json -diff
src-tauri/Cargo.lock -diff
